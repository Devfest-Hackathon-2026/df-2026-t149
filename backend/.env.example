# ローカル開発用の例。コピーして .env にする（.env はコミットしない）
PORT=8080

# Places API のキー。空なら Places API を呼ばずにダミーデータだけで動く
PLACES_API_KEY=
# サーバー全体で Places API を呼ぶ1日の上限（JST の日付で区切る）。上限に達するとダミーを返す
PLACES_DAILY_LIMIT=100
# 1人が Places API を呼べる1日の回数。代替提案の検索は1回で4回分になる。上限に達するとダミーを返す
PLACES_USER_DAILY_LIMIT=30
# サーバー全体で Place Details（チェックインの位置の確認、思い出ログの名前の取得）を種類ごとに呼ぶ1日の上限
PLACES_DETAILS_DAILY_LIMIT=150

# Geminiちゃん。fake: キーワードで答える簡易版（Gemini を呼ばない） / vertex: Vertex AI の Gemini を呼ぶ（GOOGLE_CLOUD_PROJECT と gcloud auth application-default login が必要）
GEMINI_MODE=fake
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_LOCATION=global
# Gemini を呼ぶ1日の上限（全体、1人あたり）。1回の相談で最大2回呼ぶ。上限に達すると簡易版で答える
GEMINI_DAILY_LIMIT=300
GEMINI_USER_DAILY_LIMIT=30

# CORS で許すオリジン（カンマ区切り）。localhost は常に許す
ALLOWED_ORIGINS=

# fake: Bearer の文字列をそのまま uid にする（"anon:xxx" なら匿名扱い） / firebase: IDトークンを検証
AUTH_MODE=fake

# memory: プロセス内に保存 / firestore: Firestore（FIRESTORE_EMULATOR_HOST があればエミュレーター）
STORE_MODE=memory

# AUTH_MODE=firebase または STORE_MODE=firestore のとき必要
GOOGLE_CLOUD_PROJECT=
