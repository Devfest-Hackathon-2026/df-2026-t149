rules_version = '2';

// Firestore を読み書きするのは API サーバーだけである。構成は docs/data-model.md。
// サーバーはサービスアカウントで接続するため、このルールの影響を受けない。
// 変えたら `firebase deploy --only firestore:rules` で反映する。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
