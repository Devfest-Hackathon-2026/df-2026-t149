# アプリの鍵と設定の例。コピーして .env にする（.env はコミットしない）
# 地図と Firebase の設定はアプリに入るので、Google Cloud と Firebase で使える場所を制限する
# 変更したら cd app && dart run tool/apply_env.dart を実行する

# Maps JavaScript API のキー（Web 版）。空なら簡易地図で動く
MAPS_WEB_API_KEY=
# Maps SDK for Android のキー（Android 版）。空なら簡易地図で動く
MAPS_ANDROID_API_KEY=

# Firebase のプロジェクトの設定。空なら Firebase を使わずに端末に保存して動く
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_ANDROID_APP_ID=
# Firebase の Google ログインの設定にある「ウェブ クライアント ID」。Android 版のログインで使う
FIREBASE_WEB_CLIENT_ID=

# Android 配布用の署名鍵。パスは app/ からの相対パス
ANDROID_SIGNING_STORE_FILE=android/uramichi-release.p12
ANDROID_SIGNING_KEY_ALIAS=
ANDROID_SIGNING_STORE_PASSWORD=
ANDROID_SIGNING_KEY_PASSWORD=
